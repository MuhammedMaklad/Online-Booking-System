## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (DotSettings)
*.DotSettings.user

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
Log/
[Ll]og/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/
# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/lib/

# Visual Studio Store app package directories
AppPackages/
BundleArtifacts/

# Directory for Microsoft.Tests.Runtime
TestResults/

# Item caches
Imagecache/
Graphicscache/

# Microsoft Azure Build Output
csx/
*.pubxml
*.azurePubxml

# Azurite local storage
__blobstorage__
__queuestorage__
__tablestorage__

# Code Analysis results
*.CodeAnalysisLog
*.lastcodeanalysissucceeded

# Entity Framework skip analyzers
App_Data/*.mdf
App_Data/*.ldf
App_Data/*.sdum
App_Data/*.bak

# CoreCLR traces
*.4.etl
*.4.etl.ckp

# NUnit
*.VisualState.xml
TestResult.xml
nunit-agent.log

# JSTest.Reports
_Chutzpah*

# Mac OS X temporary files
.DS_Store

# Rider
.idea/
*.sln.iml

# VS Code
.vscode/

# User-specific files
.env
.env.*
!.env.example

# End of standard Visual Studio ignore
appsettings.*.json
