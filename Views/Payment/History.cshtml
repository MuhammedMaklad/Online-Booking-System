@model IEnumerable<Online_Booking_System.ViewModels.Payment.PaymentTransactionViewModel>

@{
    ViewData["Title"] = "Payment History";
    int bookingId = ViewBag.BookingId ?? 0;
}

<div class="container py-5 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-receipt text-primary me-2"></i>Payment History
        </h2>

        @if (bookingId > 0)
        {
            <a asp-controller="Booking" asp-action="MyBookings" class="btn btn-outline-secondary rounded-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Bookings
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-receipt text-muted" style="font-size:4rem;"></i>
            <h5 class="mt-3 fw-bold">No transactions found</h5>
            <p class="text-muted">No payment records exist for this booking.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Property</th>
                            <th>Method</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th class="pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var txn in Model)
                        {
                            string statusBadge = txn.Status.ToString() switch
                            {
                                "Completed" => "bg-success",
                                "Pending" => "bg-warning text-dark",
                                "Processing" => "bg-info text-dark",
                                "Failed" => "bg-danger",
                                "Refunded" => "bg-secondary",
                                "Cancelled" => "bg-dark",
                                _ => "bg-secondary"
                            };

                            string methodIcon = txn.Method.ToString() switch
                            {
                                "Stripe" => "bi-stripe",
                                _ => "bi-credit-card"
                            };

                            <tr>
                                <td class="ps-4 text-muted small">#@txn.Id</td>
                                <td class="fw-semibold">@txn.PropertyTitle</td>
                                <td>
                                    <span class="d-flex align-items-center gap-2">
                                        <i class="bi @methodIcon"></i> @txn.Method
                                    </span>
                                </td>
                                <td class="fw-bold text-primary">
                                    @txn.Amount.ToString("C") @txn.Currency
                                </td>
                                <td>
                                    <span class="badge @statusBadge rounded-pill px-3 py-2">@txn.Status</span>
                                </td>
                                <td class="text-muted small">@txn.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                <td class="pe-4">
                                    @if (txn.Status == Online_Booking_System.Models.Payments.PaymentStatus.Completed && User.IsInRole("Admin"))
                                    {
                                        <a asp-controller="Payment"
                                               asp-action="Refund"
                                               asp-route-id="@txn.Id"
                                               class="btn btn-sm btn-outline-danger rounded-3">
                                            <i class="bi bi-arrow-counterclockwise me-1"></i> Refund
                                        </a>
                                    }
                                    else if (txn.FailureReason is not null)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-link text-danger p-0 border-0 text-decoration-none"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#reason-@txn.Id"
                                                aria-expanded="false"
                                                aria-controls="reason-@txn.Id">
                                            <i class="bi bi-info-circle me-1"></i> See reason
                                        </button>
                                    }
                                </td>
                            </tr>

                            @if (txn.FailureReason is not null)
                            {
                                <tr class="collapse bg-light-subtle" id="reason-@txn.Id">
                                    <td colspan="7" class="px-4 py-3">
                                        <div class="alert alert-danger d-flex align-items-center mb-0 rounded-3 shadow-sm border-0">
                                            <i class="bi bi-exclamation-triangle-fill fs-5 me-3"></i>
                                            <div>
                                                <strong class="d-block mb-1">Gateway Processing Error:</strong>
                                                <span class="small text-muted">@txn.FailureReason</span>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>