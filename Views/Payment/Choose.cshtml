@model Online_Booking_System.ViewModels.Payment.InitiatePaymentViewModel

@{
    ViewData["Title"] = "Secure Payment";
}

<div class="container py-5 mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">

            <div class="text-center mb-5">
                <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                     style="width:72px;height:72px;">
                    <i class="bi bi-credit-card-2-front-fill text-primary fs-2"></i>
                </div>
                <h2 class="fw-bold">Secure Payment</h2>
                <p class="text-muted">Complete your booking with Stripe</p>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form asp-action="Initiate" asp-controller="Payment" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="BookingId" />
                <input type="hidden" asp-for="Currency" />
                <input type="hidden" name="Method" value="Stripe" />

                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4 d-flex align-items-center gap-4">
                        <div class="bg-primary bg-opacity-10 rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width:64px;height:64px;">
                            <i class="bi bi-stripe text-primary fs-2"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-bold fs-5 mb-1">Credit / Debit Card</div>
                            <div class="text-muted small">
                                Visa, Mastercard, Amex — powered by Stripe
                            </div>
                            <div class="d-flex gap-2 mt-2">
                                <span class="badge bg-light text-dark border small">
                                    <i class="bi bi-shield-fill-check text-success me-1"></i>Secure
                                </span>
                                <span class="badge bg-light text-dark border small">
                                    <i class="bi bi-lightning-fill text-warning me-1"></i>Instant
                                </span>
                            </div>
                        </div>
                        <i class="bi bi-check-circle-fill text-primary fs-4"></i>
                    </div>
                </div>

                <button type="submit"
                        class="btn btn-primary w-100 py-3 rounded-3 fw-semibold fs-6">
                    <i class="bi bi-lock-fill me-2"></i>Proceed to Payment
                </button>

                <p class="text-center text-muted small mt-3">
                    <i class="bi bi-shield-lock-fill me-1 text-success"></i>
                    256-bit SSL encryption. We never store your card details.
                </p>
            </form>

        </div>
    </div>
</div>