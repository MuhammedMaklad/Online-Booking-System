@model Online_Booking_System.ViewModels.Payment.RefundRequestViewModel

@{
    ViewData["Title"] = "Issue Refund";
}

<div class="container py-5 mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-light border-0 py-3">
                    <h5 class="card-title fw-bold text-danger mb-0">
                        <i class="bi bi-arrow-counterclockwise me-2"></i>Issue Refund
                    </h5>
                </div>
                
                <div class="card-body p-4">
                    <div class="mb-4 pb-3 border-bottom">
                        <p class="text-muted small mb-1">Property</p>
                        <h6 class="fw-bold mb-3">@Model.PropertyTitle</h6>
                        
                        <p class="text-muted small mb-1">Transaction reference</p>
                        <code class="text-dark">#@Model.TransactionId</code>
                    </div>

                    <form asp-controller="Payment" asp-action="Refund" method="post" id="refundForm">
                        @Html.AntiForgeryToken()
                        
                        <input type="hidden" asp-for="TransactionId" />
                        <input type="hidden" asp-for="PropertyTitle" />
                        <input type="hidden" asp-for="Currency" />

                        <div class="mb-3">
                            <label asp-for="Amount" class="form-label fw-semibold">Refund Amount (@Model.Currency)</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" 
                                       asp-for="Amount" 
                                       class="form-control" 
                                       step="0.01" 
                                       min="0.01" 
                                       max="@Model.Amount" 
                                       required />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Reason" class="form-label fw-semibold">Reason for Refund</label>
                            <textarea asp-for="Reason" 
                                      class="form-control rounded-3" 
                                      rows="4" 
                                      placeholder="Provide a reason for processing this refund..." 
                                      required></textarea>
                            <span asp-validation-for="Reason" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-action="History" class="btn btn-outline-secondary rounded-3 px-4">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-danger rounded-3 px-4" id="submitRefundBtn">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> Confirm Refund
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const refundForm = document.getElementById('refundForm');
            const submitButton = document.getElementById('submitRefundBtn');

            if (refundForm) {
                refundForm.addEventListener('submit', function () {
                    if (submitButton) {
                        submitButton.disabled = true;
                        submitButton.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Processing...';
                    }
                });
            }
        });
    </script>
}