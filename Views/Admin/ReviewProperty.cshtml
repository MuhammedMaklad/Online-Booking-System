@model Online_Booking_System.ViewModels.AdminReviewPropertyViewModel
@{
    ViewData["Title"] = "Review Property";
    var p = ViewBag.Property as Online_Booking_System.ViewModels.AdminPropertyListViewModel;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="d-flex align-items-center gap-3 mb-4">
                <a asp-action="Properties" class="btn btn-outline-secondary rounded-circle p-2 lh-1">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <div>
                    <h2 class="fw-bold mb-0">Review Property</h2>
                    <p class="text-muted mb-0">Approve or reject this listing</p>
                </div>
            </div>

            @if (p != null)
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center gap-4">
                            <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "https://placehold.co/100x100" : p.ImageUrl)"
                                 class="rounded-4 object-fit-cover" style="width:100px;height:100px;" />
                            <div>
                                <h5 class="fw-bold mb-1">@p.Title</h5>
                                <p class="text-muted mb-1">
                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i>@p.City, @p.Country
                                </p>
                                <p class="mb-1 fw-bold text-primary">$@p.PricePerNight / night</p>
                                <small class="text-muted">Owner: @p.OwnerName · @p.OwnerEmail</small>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(p.AdminNotes))
                        {
                            <div class="alert alert-info mt-3 mb-0 small">
                                <strong>Previous notes:</strong> @p.AdminNotes
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <form asp-action="ReviewProperty" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="PropertyId" />

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Decision</label>
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Action"
                                           value="Approve" id="approve" />
                                    <label class="form-check-label text-success fw-semibold" for="approve">
                                        <i class="bi bi-check-circle-fill me-1"></i>Approve
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Action"
                                           value="Reject" id="reject" />
                                    <label class="form-check-label text-danger fw-semibold" for="reject">
                                        <i class="bi bi-x-circle-fill me-1"></i>Reject
                                    </label>
                                </div>
                            </div>
                            <span asp-validation-for="Action" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="AdminNotes" class="form-label fw-semibold">
                                Notes <small class="text-muted fw-normal">(optional, visible to owner)</small>
                            </label>
                            <textarea asp-for="AdminNotes" class="form-control" rows="3"
                                      placeholder="Reason for rejection or approval notes..."></textarea>
                        </div>

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-primary px-5 rounded-pill">
                                Submit Decision
                            </button>
                            <a asp-action="Properties" class="btn btn-outline-secondary rounded-pill px-4">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}