@model Online_Booking_System.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">
                <i class="bi bi-shield-fill-check text-primary me-2"></i>Admin Dashboard
            </h2>
            <p class="text-muted mb-0">Platform overview and moderation</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="text-muted fw-semibold">Total Users</span>
                        <div class="bg-primary bg-opacity-10 rounded-3 p-2">
                            <i class="bi bi-people-fill text-primary fs-4"></i>
                        </div>
                    </div>
                    <h2 class="fw-bold mb-0">@Model.TotalUsers</h2>
                    <small class="text-success fw-semibold">@Model.ActiveUsers active</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="text-muted fw-semibold">Properties</span>
                        <div class="bg-warning bg-opacity-10 rounded-3 p-2">
                            <i class="bi bi-house-door-fill text-warning fs-4"></i>
                        </div>
                    </div>
                    <h2 class="fw-bold mb-0">@Model.TotalProperties</h2>
                    <small class="text-warning fw-semibold">@Model.PendingProperties pending review</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="text-muted fw-semibold">Payments</span>
                        <div class="bg-success bg-opacity-10 rounded-3 p-2">
                            <i class="bi bi-credit-card-fill text-success fs-4"></i>
                        </div>
                    </div>
                    <h2 class="fw-bold mb-0">$@Model.TotalPaymentRevenue.ToString("N0")</h2>
                    <small class="text-muted">@Model.CompletedPayments completed payments</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="text-muted fw-semibold">Advertisements</span>
                        <div class="bg-info bg-opacity-10 rounded-3 p-2">
                            <i class="bi bi-megaphone-fill text-info fs-4"></i>
                        </div>
                    </div>
                    <h2 class="fw-bold mb-0">@Model.TotalAdvertisements</h2>
                    <small class="text-warning fw-semibold">@Model.PendingAdvertisements pending review</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Action Cards -->
    <div class="row g-3 mb-5">
        <div class="col-md-3">
            <a asp-action="Properties" asp-route-Status="Pending"
                   class="card border-0 shadow-sm rounded-4 text-decoration-none h-100">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="bg-warning bg-opacity-10 rounded-3 p-3">
                        <i class="bi bi-hourglass-split text-warning fs-3"></i>
                    </div>
                    <div>
                        <div class="fw-bold">Review Properties</div>
                        <small class="text-muted">@Model.PendingProperties pending</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a asp-action="Advertisements" asp-route-Status="Pending"
                   class="card border-0 shadow-sm rounded-4 text-decoration-none h-100">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="bg-info bg-opacity-10 rounded-3 p-3">
                        <i class="bi bi-megaphone text-info fs-3"></i>
                    </div>
                    <div>
                        <div class="fw-bold">Review Ads</div>
                        <small class="text-muted">@Model.PendingAdvertisements pending</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a asp-controller="Account" asp-action="Users"
                   class="card border-0 shadow-sm rounded-4 text-decoration-none h-100">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                        <i class="bi bi-people text-primary fs-3"></i>
                    </div>
                    <div>
                        <div class="fw-bold">Manage Users</div>
                        <small class="text-muted">Roles, status, removal</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a asp-controller="Payment" asp-action="History" asp-route-bookingId="0"
                   class="card border-0 shadow-sm rounded-4 text-decoration-none h-100">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="bg-success bg-opacity-10 rounded-3 p-3">
                        <i class="bi bi-receipt text-success fs-3"></i>
                    </div>
                    <div>
                        <div class="fw-bold">Payment History</div>
                        <small class="text-muted">Transactions & refunds</small>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
            <h5 class="fw-bold mb-0">Recent Activity</h5>
        </div>
        <div class="card-body p-4">
            @if (!Model.RecentActivity.Any())
            {
                <p class="text-muted text-center py-3">No recent activity.</p>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var item in Model.RecentActivity)
                    {
                        string icon = item.Type switch
                        {
                            "User" => "bi-person-fill text-primary",
                            "Property" => "bi-house-fill text-warning",
                            _ => "bi-bell-fill text-secondary"
                        };
                        <div class="list-group-item px-0 py-2 border-0 border-bottom d-flex align-items-center gap-3">
                            <i class="bi @icon fs-5"></i>
                            <div>
                                <div class="small fw-semibold">@item.Description</div>
                                <div class="text-muted" style="font-size:12px;">
                                    @item.CreatedAt.ToString("MMM dd, yyyy · HH:mm")
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>