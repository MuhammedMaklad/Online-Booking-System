@model Online_Booking_System.ViewModels.ConfirmEmailViewModel

@{
    ViewData["Title"] = "Confirm Email";
}

<div class="row justify-content-center fade-in">
    <div class="col-md-6">
        <div class="card border-0 shadow-lg p-4 text-center">
            <div class="mb-4">
                <div class="bg-info-subtle text-info rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-envelope-check" viewBox="0 0 16 16">
                        <path d="M2 2a2 2 0 0 0-2 2v8.01A2 2 0 0 0 2 14h5.5a.5.5 0 0 0 0-1H2a1 1 0 0 1-.966-.741l5.64-3.471L8 9.583l7-4.2V8.5a.5.5 0 0 0 1 0V4a2 2 0 0 0-2-2H2Zm3.708 6.208L1 11.105V5.383l4.708 2.825ZM1 4.217V4a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v.217l-7 4.2-7-4.2Z"/>
                        <path d="M16 12.5a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0Zm-1.993-1.679a.5.5 0 0 0-.686.172l-1.17 1.95-.547-.547a.5.5 0 0 0-.708.708l.774.773a.75.75 0 0 0 1.174-.144l1.335-2.226a.5.5 0 0 0-.172-.686Z"/>
                    </svg>
                </div>
                <h2 class="fw-bold text-primary">Confirm Your Email</h2>
                <p class="text-muted">You're almost there! Please confirm your email address to activate your account.</p>
            </div>

            <div class="card bg-light border-0 mb-4 text-start">
                <div class="card-body">
                    <div class="small text-muted mb-1">Confirmation Details</div>
                    <div class="fw-semibold">Token: <span class="text-primary">@Model.Token</span></div>
                    <div class="small text-muted mt-1">User ID: @Model.UserId</div>
                </div>
            </div>

            <form asp-action="ConfirmEmail" method="post">
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Token" />

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-lg">Confirm Email Address</button>
                </div>
            </form>
        </div>
    </div>
</div>