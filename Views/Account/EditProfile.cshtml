@model Online_Booking_System.ViewModels.EditProfileViewModel

@{
    ViewData["Title"] = "Edit Profile";
}

<div class="row justify-content-center fade-in">
    <div class="col-md-7">
        <div class="card border-0 shadow-lg p-4">
            <div class="text-center mb-4">
                <h2 class="fw-bold text-primary">Edit Profile</h2>
                <p class="text-muted">Update your personal information.</p>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form asp-action="EditProfile" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input asp-for="FirstName" class="form-control" placeholder="First Name" />
                            <label asp-for="FirstName">First Name</label>
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input asp-for="LastName" class="form-control" placeholder="Last Name" />
                            <label asp-for="LastName">Last Name</label>
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="PhoneNumber" class="form-control" placeholder="Phone Number" />
                    <label asp-for="PhoneNumber">Phone Number</label>
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="AvatarUrl" class="form-control" placeholder="Avatar URL" />
                    <label asp-for="AvatarUrl">Avatar URL</label>
                    <span asp-validation-for="AvatarUrl" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-4">
                    <textarea asp-for="Bio" class="form-control" placeholder="Bio"
                              style="height: 120px;"></textarea>
                    <label asp-for="Bio">Bio</label>
                    <span asp-validation-for="Bio" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-primary px-5 rounded-pill">
                        <i class="bi bi-check-lg me-1"></i> Save Changes
                    </button>
                    <a asp-action="Profile" class="btn btn-outline-secondary rounded-pill px-4">
                        Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}