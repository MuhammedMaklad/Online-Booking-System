@model Online_Booking_System.ViewModels.AssignRoleViewModel

@{
    ViewData["Title"] = "Assign Role";
}

<div class="row justify-content-center fade-in">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm p-4">
            <h2 class="fw-bold text-primary mb-4 border-bottom pb-2">Assign User Role</h2>

            @if (ViewBag.User != null)
            {
                <div class="card bg-light border-0 mb-4">
                    <div class="card-body">
                        <div class="small text-muted mb-1">Target User</div>
                        <div class="fw-bold">@ViewBag.User.Email</div>
                    </div>
                </div>
            }

            <form asp-action="AssignRole" method="post">
                <input type="hidden" asp-for="UserId" />

                <div class="mb-4">
                    <label asp-for="Role" class="form-label text-muted small">Select New Role</label>
                    <select asp-for="Role" class="form-select form-select-lg">
                        <option value="">-- Choose Role --</option>
                        <option value="Admin">Admin</option>
                        <option value="User">User</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">Assign Role</button>
                    <a asp-action="Users" class="btn btn-light px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}