<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Online Booking System</title>

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <!-- Bootstrap CSS -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Online_Booking_System.styles.css"
          asp-append-version="true" />
</head>

<body>

    <header>

        <nav class="navbar navbar-expand-sm navbar-light fixed-top">

            <div class="container">

                <a class="navbar-brand"
                       asp-area=""
                       asp-controller="Home"
                       asp-action="Index">

                    BookingSystem

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">

                    <ul class="navbar-nav align-items-center">

                        <li class="nav-item">
                            <a class="nav-link px-3"
                                   asp-controller="Home"
                                   asp-action="Index">

                                Home

                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true )
                        {
                            if(!User.IsInRole("Admin") && !User.IsInRole("Owner")){
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-semibold"
                                       asp-controller="Property"
                                       asp-action="Index">

                                    Browse Properties

                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark fw-semibold"
                                       asp-controller="Booking"
                                       asp-action="MyBookings">

                                    My Bookings

                                </a>
                            </li>
                            }
                            @if (User.IsInRole("Owner"))
                            {
                                <li class="nav-item dropdown ms-lg-1">

                                    <a class="nav-link dropdown-toggle text-dark fw-semibold"
                                           href="#"
                                           role="button"
                                           data-bs-toggle="dropdown"
                                           aria-expanded="false">

                                        <i class="bi bi-house-gear me-1"></i>
                                        Owner

                                    </a>

                                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow mt-3">

                                        <li>
                                            <a class="dropdown-item py-2"
                                                   asp-controller="Owner"
                                                   asp-action="Dashboard">

                                                <i class="bi bi-speedometer2 me-2 text-primary"></i>
                                                Dashboard

                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item py-2"
                                                   asp-controller="Owner"
                                                   asp-action="MyProperties">

                                                <i class="bi bi-house-door me-2 text-primary"></i>
                                                My Properties

                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item py-2"
                                                   asp-controller="Owner"
                                                   asp-action="CreateProperty">

                                                <i class="bi bi-plus-circle me-2 text-success"></i>
                                                Add Property

                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item py-2"
                                                   asp-controller="Advertisement"
                                                   asp-action="MyAdvertisements">

                                                <i class="bi bi-megaphone me-2 text-info"></i>
                                                My Advertisements

                                            </a>
                                        </li>

                                    </ul>

                                </li>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item ms-lg-1">

                                    <a class="nav-link text-dark fw-semibold"
                                           asp-controller="Admin"
                                           asp-action="Dashboard">

                                        <i class="bi bi-shield-fill-check me-1 text-primary"></i>
                                        Admin

                                    </a>

                                </li>
                            }

                            <li class="nav-item dropdown ms-lg-2">

                                <a class="nav-link dropdown-toggle bg-primary-subtle text-primary rounded-pill px-4"
                                       href="#"
                                       id="navbarDropdown"
                                       role="button"
                                       data-bs-toggle="dropdown"
                                       aria-expanded="false">

                                    <span class="me-1">Account</span>

                                </a>

                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow mt-3"
                                    aria-labelledby="navbarDropdown">

                                    <li>
                                        <a class="dropdown-item py-2"
                                               asp-controller="Account"
                                               asp-action="Profile">

                                            My Profile

                                        </a>
                                    </li>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2"
                                                   asp-controller="Account"
                                                   asp-action="Users">

                                                User Management

                                            </a>
                                        </li>
                                    }

                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>

                                    <li>

                                        <form asp-controller="Account"
                                              asp-action="Logout"
                                              method="post">

                                            <button type="submit"
                                                    class="dropdown-item py-2 text-danger">

                                                Logout

                                            </button>

                                        </form>

                                    </li>

                                </ul>

                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-lg-2">

                                <a class="nav-link"
                                       asp-controller="Account"
                                       asp-action="Login">

                                    Login

                                </a>

                            </li>

                            <li class="nav-item ms-lg-2">

                                <a class="btn btn-primary rounded-pill px-4"
                                       asp-controller="Account"
                                       asp-action="Register">

                                    Register

                                </a>

                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <div class="container" style="margin-top:50px">

        <main role="main" class="pb-3 fade-in">

            @RenderBody()

        </main>

    </div>

    <footer class="footer text-muted">

        <div class="container text-center">

            &copy; 2026 - Online Booking System -

            <a asp-area=""
                   asp-controller="Home"
                   asp-action="Privacy">

                Privacy

            </a>

        </div>

    </footer>

    <!-- Bootstrap JS ONLY -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Site JS -->
    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>