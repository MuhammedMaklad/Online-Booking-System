@{
    ViewData["Title"] = "Page Not Found";
    Layout = "_Layout";
}

<div class="container py-5 text-center">
    <div class="py-5">
        <div class="display-1 fw-bold text-primary mb-3">404</div>
        <h2 class="fw-bold mb-3">Page Not Found</h2>
        <p class="text-muted mb-4" style="max-width:420px; margin:0 auto;">
            The page you're looking for doesn't exist or has been moved.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Home" asp-action="Index"
                   class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-house me-1"></i> Go Home
            </a>
            <a asp-controller="Property" asp-action="Index"
                   class="btn btn-outline-primary rounded-pill px-4">
                <i class="bi bi-search me-1"></i> Browse Properties
            </a>
        </div>
    </div>
</div>