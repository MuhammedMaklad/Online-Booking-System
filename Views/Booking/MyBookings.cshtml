@model IEnumerable<Online_Booking_System.ViewModels.MyBookingViewModel>

@{
    ViewData["Title"] = "My Bookings";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container py-5 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="bi bi-journal-bookmark-fill text-primary me-2"></i>My Bookings</h2>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-calendar-x text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 fw-bold">No bookings yet!</h4>
            <p class="text-muted">It looks like you haven't booked any properties yet.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">Explore Properties</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var booking in Model)
            {
                string badgeClass = booking.Status switch
                {
                    "Pending" => "bg-warning text-dark",
                    "Confirmed" => "bg-success",
                    "Cancelled" => "bg-danger",
                    _ => "bg-secondary"
                };

                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="position-relative">
                            <img src="@booking.PropertyImageUrl" class="card-img-top" style="height: 200px; object-fit: cover;" alt="@booking.PropertyTitle">
                            <span class="badge @badgeClass position-absolute top-0 end-0 m-3 px-3 py-2 rounded-pill shadow-sm">
                                @booking.Status
                            </span>
                        </div>
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-1">@booking.PropertyTitle</h5>
                            <p class="text-muted small mb-3"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@booking.PropertyCity</p>

                            <div class="d-flex justify-content-between mb-2 small">
                                <span class="text-muted">Check-in:</span>
                                <span class="fw-bold">@booking.CheckIn.ToString("MMM dd, yyyy")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-3 small">
                                <span class="text-muted">Check-out:</span>
                                <span class="fw-bold">@booking.CheckOut.ToString("MMM dd, yyyy")</span>
                            </div>

                            <hr class="text-muted opacity-25">

                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="text-muted small d-block">Total Price</span>
                                    <span class="fw-bold text-primary fs-5">$@booking.TotalPrice</span>
                                </div>
                                <div class="text-end">
                                    <span class="text-muted small d-block">Guests</span>
                                    <span class="fw-bold"><i class="bi bi-person-fill me-1"></i>@booking.GuestsCount</span>
                                </div>
                            </div>
                        </div>
                        @if (booking.Status == "Pending" || booking.Status == "Confirmed")
                        {
                            <div class="card-footer bg-white border-0 p-3 pt-0">
                                <form asp-controller="Booking" asp-action="Cancel" method="post" onsubmit="return confirm('Are you sure you want to cancel this booking?');">
                                    <input type="hidden" name="bookingId" value="@booking.BookingId" />
                                    <button type="submit" class="btn btn-outline-danger w-100 rounded-3">
                                        Cancel Booking
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>