@model Online_Booking_System.Models.Properties.Property

@{
    ViewData["Title"] = Model.Title ?? "Property Details";

    var facilitiesList = string.IsNullOrEmpty(Model.Facilities)
        ? new List<string>()
        : Model.Facilities.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(f => f.Trim()).ToList();

    var galleryImages = string.IsNullOrEmpty(Model.GalleryImages)
        ? new List<string>()
        : Model.GalleryImages.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim()).ToList();

    if (!string.IsNullOrEmpty(Model.ImageUrl) && !galleryImages.Contains(Model.ImageUrl))
    {
        galleryImages.Insert(0, Model.ImageUrl);
    }

    double rating = Model.Rating != null ? Convert.ToDouble(Model.Rating) : 0;
    int fullStars = (int)Math.Floor(rating);
    bool hasHalfStar = (rating - fullStars) >= 0.5;
    int emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);

    Func<string, string> GetFacilityIcon = (facilityName) =>
    {
        var name = facilityName.ToLower();
        if (name.Contains("wifi")) return "bi-wifi";
        if (name.Contains("pool")) return "bi-water";
        if (name.Contains("parking")) return "bi-car-front-fill";
        if (name.Contains("air conditioning") || name.Contains("ac")) return "bi-snow";
        if (name.Contains("kitchen")) return "bi-fire";
        if (name.Contains("gym")) return "bi-bicycle";
        if (name.Contains("sea view") || name.Contains("beach")) return "bi-brightness-high-fill";
        if (name.Contains("breakfast") || name.Contains("restaurant")) return "bi-cup-hot-fill";
        if (name.Contains("tv")) return "bi-tv-fill";
        if (name.Contains("balcony")) return "bi-building";
        return "bi-check2-circle";
    };
}

<div class="container py-5">
    <div class="row g-5">

        <!-- LEFT SIDE -->
        <div class="col-lg-8">

            <!-- GALLERY -->
            @if (galleryImages.Any())
            {
                <div id="propertyGallery" class="carousel slide mb-4 shadow-sm rounded-4 overflow-hidden" data-bs-ride="carousel">
                    <div class="carousel-inner" style="height: 500px;">

                        @for (int i = 0; i < galleryImages.Count; i++)
                        {
                            string imagePath = galleryImages[i].Contains("/")
                                ? galleryImages[i]
                                : $"/images/properties/{galleryImages[i]}";

                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@imagePath" class="d-block w-100 h-100" style="object-fit:cover;">
                            </div>
                        }

                    </div>

                    @if (galleryImages.Count > 1)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#propertyGallery" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                        </button>

                        <button class="carousel-control-next" type="button" data-bs-target="#propertyGallery" data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span>
                        </button>
                    }
                </div>
            }

            <!-- TITLE -->
            <h1 class="fw-bold mb-1">@Model.Title</h1>

            <p class="text-muted fs-5 mb-3">
                <i class="bi bi-geo-alt-fill text-danger"></i>
                @Model.City, @Model.Country
            </p>

            <!-- RATING -->
            <div class="d-flex align-items-center mb-3">
                <div class="text-warning me-2">
                    @for (int i = 0; i < fullStars; i++)
                    {
                        <i class="bi bi-star-fill"></i>
                    }
                    @if (hasHalfStar)
                    {
                        <i class="bi bi-star-half"></i>
                    }
                    @for (int i = 0; i < emptyStars; i++)
                    {
                        <i class="bi bi-star"></i>
                    }
                </div>

                <span class="fw-bold">@Model.Rating</span>
                <span class="text-muted ms-2">(@Model.ReviewsCount reviews)</span>
            </div>

            <!-- BADGES -->
            <div class="d-flex gap-3 flex-wrap mb-4">
                <span class="badge bg-light text-dark border">
                    <i class="bi bi-door-open text-primary"></i> @Model.Bedrooms Bedrooms
                </span>

                <span class="badge bg-light text-dark border">
                    <i class="bi bi-droplet text-info"></i> @Model.Bathrooms Bathrooms
                </span>

                <span class="badge bg-light text-dark border">
                    <i class="bi bi-people text-success"></i> @Model.MaxGuests Guests
                </span>
            </div>

            <!-- DESCRIPTION -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-3">Description</h4>
                    <p class="text-muted mb-0">@Model.Description</p>
                </div>
            </div>

            <!-- FACILITIES -->
            @if (facilitiesList.Any())
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <h4 class="fw-bold mb-4">What this place offers</h4>

                        <div class="row g-4">
                            @foreach (var facility in facilitiesList)
                            {
                                <div class="col-md-6 col-lg-4 d-flex align-items-center">
                                    <i class="bi @GetFacilityIcon(facility) text-primary fs-5 me-3"></i>
                                    <span>@facility</span>
                                </div>
                            }
                        </div>

                    </div>
                </div>
            }

            <!-- MAP -->
            @if (!string.IsNullOrEmpty(Model.GoogleMapUrl))
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <h4 class="fw-bold mb-3">Location</h4>

                        <iframe src="@Model.GoogleMapUrl"
                                class="w-100 rounded-4"
                                height="300"
                                style="border:0;"
                                loading="lazy"></iframe>
                    </div>
                </div>
            }

        </div>

        <!-- RIGHT SIDE -->
        <div class="col-lg-4">

            <div class="card border-0 shadow-lg rounded-4 sticky-top" style="top:100px;">
                <div class="card-body p-4">

                    <!-- PRICE -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="fw-bold text-primary mb-0">
                            $@Model.PricePerNight
                            <span class="fs-6 text-muted fw-normal">/ night</span>
                        </h2>

                        <div class="text-warning fw-semibold">
                            <i class="bi bi-star-fill"></i> @Model.Rating
                        </div>
                    </div>

                    <hr class="mb-3" />

                    <!-- ERROR -->
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger p-2 small">
                            @TempData["Error"]
                        </div>
                    }

                    <!-- BOOKING FORM -->
                    <form asp-controller="Property" asp-action="Reserve" method="post">

                        <input type="hidden" name="PropertyId" value="@Model.Id" />

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label small text-muted text-uppercase">Check-in</label>
                                <input type="date" name="CheckIn" class="form-control" required />
                            </div>

                            <div class="col-6">
                                <label class="form-label small text-muted text-uppercase">Check-out</label>
                                <input type="date" name="CheckOut" class="form-control" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small text-muted text-uppercase">Guests</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white">
                                    <i class="bi bi-person"></i>
                                </span>

                                <input type="number"
                                       name="GuestsCount"
                                       class="form-control"
                                       value="1"
                                       min="1"
                                       max="@Model.MaxGuests"
                                       required />
                            </div>
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100 py-3 fw-bold rounded-3">
                            Reserve Now
                        </button>

                    </form>

                    <div class="text-center mt-3">
                        <small class="text-muted">You won’t be charged yet</small>
                    </div>

                    <!-- HOST CARD -->
                    <div class="d-flex align-items-center gap-3 p-3 border rounded-3 mt-4">

                        <div class="d-flex align-items-center justify-content-center bg-light rounded-circle fw-bold"
                             style="width:45px;height:45px;font-size:14px;">

                            @{
                                string initials = "HO";

                                if (Model.Owner != null)
                                {
                                    var fn = Model.Owner.FirstName;
                                    var ln = Model.Owner.LastName;

                                    var fi = !string.IsNullOrWhiteSpace(fn) ? fn[0].ToString() : "";
                                    var li = !string.IsNullOrWhiteSpace(ln) ? ln[0].ToString() : "";

                                    initials = (fi + li).ToUpper();

                                    if (string.IsNullOrWhiteSpace(initials))
                                    {
                                        initials = "HO";
                                    }
                                }
                            }

                            @initials
                        </div>

                        <div class="flex-grow-1">
                            <div class="fw-semibold">
                                @(Model.Owner?.FullName ?? "Host")
                            </div>

                            <div class="text-muted" style="font-size:12px;">
                                @{
                                    var year = Model.Owner?.CreatedAt.Year;
                                }

                                Host since @(year.HasValue? year.ToString() : "N/A")
                            </div>
                        </div>

                    </div>

                </div>
            </div>

        </div>

    </div>
</div>