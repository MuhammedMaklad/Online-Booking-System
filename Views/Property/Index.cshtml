@model Online_Booking_System.ViewModels.PropertyFilterViewModel

<div class="container py-5">

    <div class="row">

        <!-- SIDEBAR -->
        <div class="col-lg-3 mb-4">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <h4 class="fw-bold mb-4">
                        Filters
                    </h4>

                    <form method="get">

                        <!-- SEARCH -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Search
                            </label>

                            <input asp-for="SearchTerm"
                                   class="form-control"
                                   placeholder="Title or city" />
                        </div>

                        <!-- MIN PRICE -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Min Price
                            </label>

                            <input asp-for="MinPrice"
                                   class="form-control"
                                   placeholder="$0" />
                        </div>

                        <!-- MAX PRICE -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Max Price
                            </label>

                            <input asp-for="MaxPrice"
                                   class="form-control"
                                   placeholder="$5000" />
                        </div>

                        <!-- BEDROOMS -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Bedrooms
                            </label>

                            <input asp-for="Bedrooms"
                                   class="form-control"
                                   placeholder="2" />
                        </div>

                        <!-- SORT -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                Sort By
                            </label>

                            <select asp-for="SortBy"
                                    class="form-select">

                                <option value="">
                                    Newest
                                </option>

                                <option value="price_asc">
                                    Price Low To High
                                </option>

                                <option value="price_desc">
                                    Price High To Low
                                </option>

                            </select>
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">

                            Apply Filters

                        </button>

                    </form>

                </div>

            </div>

        </div>

        <!-- RESULTS -->
        <div class="col-lg-9">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>
                    <h2 class="fw-bold mb-0">
                        Properties
                    </h2>

                    <small class="text-muted">
                        @(Model.Properties?.Count() ?? 0) properties found
                    </small>
                </div>

            </div>

            <div class="row">

                @if (Model.Properties != null && Model.Properties.Any())
                {
                    @foreach (var item in Model.Properties)
                    {
                        <div class="col-md-6 col-xl-4 mb-4">

                            <div class="card shadow-sm border-0 h-100">

                                <img src="@(string.IsNullOrEmpty(item.ImageUrl)
                                         ? "https://placehold.co/600x400"
                                         : item.ImageUrl)"
                                     class="card-img-top"
                                     style="height:220px; object-fit:cover;" />

                                <div class="card-body">

                                    <div class="d-flex justify-content-between align-items-start mb-2">

                                        <h5 class="card-title fw-bold mb-0">
                                            @item.Title
                                        </h5>

                                        <span class="badge bg-primary">
                                            @item.Bedrooms BR
                                        </span>

                                    </div>

                                    <p class="text-muted mb-2">
                                        @item.City, @item.Country
                                    </p>

                                    <p class="card-text text-muted small">

                                        @(item.Description.Length > 90
                                            ? item.Description.Substring(0, 90) + "..."
                                            : item.Description)

                                    </p>

                                </div>

                                <div class="card-footer bg-white border-0">

                                    <div class="d-flex justify-content-between align-items-center">

                                        <div>
                                            <span class="fw-bold text-primary fs-5">
                                                $@item.PricePerNight
                                            </span>

                                            <small class="text-muted">
                                                / night
                                            </small>
                                        </div>

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-primary">

                                            View Details
                                        </a>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="col-12">

                        <div class="alert alert-info">

                            No properties found.

                        </div>

                    </div>
                }

            </div>

            <!-- PAGINATION -->
            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-center mt-5">

                    <nav>

                        <ul class="pagination">

                            <!-- Previous -->
                            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">

                                <a class="page-link"
                                   asp-route-PageNumber="@(Model.PageNumber - 1)"
                                   asp-route-SearchTerm="@Model.SearchTerm"
                                   asp-route-MinPrice="@Model.MinPrice"
                                   asp-route-MaxPrice="@Model.MaxPrice"
                                   asp-route-Bedrooms="@Model.Bedrooms"
                                   asp-route-SortBy="@Model.SortBy">

                                    Previous

                                </a>

                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(Model.PageNumber == i ? "active" : "")">

                                    <a class="page-link"
                                       asp-route-PageNumber="@i"
                                       asp-route-SearchTerm="@Model.SearchTerm"
                                       asp-route-MinPrice="@Model.MinPrice"
                                       asp-route-MaxPrice="@Model.MaxPrice"
                                       asp-route-Bedrooms="@Model.Bedrooms"
                                       asp-route-SortBy="@Model.SortBy">

                                        @i

                                    </a>

                                </li>
                            }

                            <!-- Next -->
                            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">

                                <a class="page-link"
                                   asp-route-PageNumber="@(Model.PageNumber + 1)"
                                   asp-route-SearchTerm="@Model.SearchTerm"
                                   asp-route-MinPrice="@Model.MinPrice"
                                   asp-route-MaxPrice="@Model.MaxPrice"
                                   asp-route-Bedrooms="@Model.Bedrooms"
                                   asp-route-SortBy="@Model.SortBy">

                                    Next

                                </a>

                            </li>

                        </ul>

                    </nav>

                </div>
            }

        </div>

    </div>

</div>