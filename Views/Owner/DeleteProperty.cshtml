@model Online_Booking_System.ViewModels.EditPropertyViewModel

@{
    ViewData["Title"] = "Delete Property";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-lg-5 text-center">

                    <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex p-4 mb-4">
                        <i class="bi bi-trash3-fill text-danger" style="font-size: 2.5rem;"></i>
                    </div>

                    <h3 class="fw-bold mb-2">Delete Property</h3>
                    <p class="text-muted mb-4">
                        Are you sure you want to delete <strong>@Model.Title</strong>?
                        This action cannot be undone and all associated bookings will remain in the system.
                    </p>

                    <!-- Property Preview -->
                    <div class="card border rounded-3 mb-4 text-start">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-center gap-3">
                                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://placehold.co/80x80" : Model.ImageUrl)"
                                     class="rounded-3 object-fit-cover"
                                     style="width:80px;height:80px;" />
                                <div>
                                    <div class="fw-bold">@Model.Title</div>
                                    <div class="text-muted small">@Model.City, @Model.Country</div>
                                    <div class="text-primary fw-semibold small">$@Model.PricePerNight / night</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-3 justify-content-center">
                        <form asp-action="DeleteProperty" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger px-5 rounded-pill">
                                <i class="bi bi-trash me-1"></i> Yes, Delete
                            </button>
                        </form>
                        <a asp-action="MyProperties" class="btn btn-outline-secondary rounded-pill px-4">
                            Cancel
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
