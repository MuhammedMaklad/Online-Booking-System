@model Online_Booking_System.ViewModels.PropertyBookingsViewModel

@{
    ViewData["Title"] = "Cancel Booking";
    var bookingId = ViewData["BookingToCancel"] as int? ?? 0;
}

<div class="container py-5">
    <div class="card max-width-600 mx-auto shadow-sm">
        <div class="card-body">
            <h4 class="card-title text-danger">Cancel Booking</h4>
            <p class="text-muted">Are you sure you want to cancel or reject this booking request? This action cannot be undone.</p>

            <form asp-action="CancelBooking" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookingId" value="@bookingId" />
                <input type="hidden" name="propertyId" value="@Model.PropertyId" />

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-danger px-4">Cancel Booking</button>
                    <a asp-action="PropertyBookings" asp-route-id="@Model.PropertyId" class="btn btn-outline-secondary">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>