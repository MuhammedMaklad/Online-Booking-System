@model IEnumerable<Online_Booking_System.ViewModels.OwnerPropertySummaryViewModel>

@{
    ViewData["Title"] = "My Properties";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">
                <i class="bi bi-house-door-fill text-primary me-2"></i>My Properties
            </h2>
            <small class="text-muted">@Model.Count() properties listed</small>
        </div>
        <a asp-action="CreateProperty" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-plus-lg me-1"></i> Add Property
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-house-x text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 fw-bold">No properties yet</h4>
            <p class="text-muted">Start by adding your first property listing.</p>
            <a asp-action="CreateProperty" class="btn btn-primary mt-2 rounded-pill px-4">
                <i class="bi bi-plus-lg me-1"></i> Add Property
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var p in Model)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">

                        <div class="position-relative">
                            <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "https://placehold.co/600x400" : p.ImageUrl)"
                                 class="card-img-top"
                                 style="height:220px; object-fit:cover;" />
                            <span class="badge bg-primary position-absolute top-0 start-0 m-3 rounded-pill px-3">
                                @p.Bedrooms BR
                            </span>
                        </div>

                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-1 text-truncate">@p.Title</h5>
                            <p class="text-muted small mb-3">
                                <i class="bi bi-geo-alt-fill text-danger me-1"></i>@p.City, @p.Country
                            </p>

                            <div class="d-flex gap-3 mb-3 small text-muted">
                                <span><i class="bi bi-door-open me-1"></i>@p.Bedrooms beds</span>
                                <span><i class="bi bi-droplet me-1"></i>@p.Bathrooms baths</span>
                                <span><i class="bi bi-people me-1"></i>@p.MaxGuests guests</span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fw-bold text-primary fs-5">$@p.PricePerNight</span>
                                    <small class="text-muted"> / night</small>
                                </div>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-calendar-check me-1"></i>@p.TotalBookings bookings
                                </span>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-0 p-3 pt-0">
                            <div class="d-flex gap-2">
                                <a asp-action="PropertyBookings" asp-route-id="@p.Id"
                                   class="btn btn-outline-primary btn-sm flex-fill rounded-3">
                                    <i class="bi bi-calendar-week me-1"></i>Bookings
                                </a>
                                <a asp-action="EditProperty" asp-route-id="@p.Id"
                                   class="btn btn-outline-secondary btn-sm flex-fill rounded-3">
                                    <i class="bi bi-pencil me-1"></i>Edit
                                </a>
                                <a asp-action="DeleteProperty" asp-route-id="@p.Id"
                                   class="btn btn-outline-danger btn-sm rounded-3">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }

</div>
