@model Online_Booking_System.ViewModels.PropertyBookingsViewModel

@{
    ViewData["Title"] = "Property Bookings";
}

<div class="container py-4">
    <div class="d-flex align-items-center mb-3">
        <a asp-action="MyProperties" class="btn btn-outline-secondary rounded-circle me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h2 class="mb-0">Bookings</h2>
            <small class="text-muted">@Model.PropertyTitle</small>
        </div>
    </div>

    <div class="d-flex gap-2 mb-4 flex-wrap">
        <span class="badge bg-secondary p-2">Total: @Model.Bookings.Count</span>
        <span class="badge bg-warning text-dark p-2">Pending Owner Approval: @Model.Bookings.Count(b => b.Status == "Pending")</span>
        <span class="badge bg-success p-2">Approved: @Model.Bookings.Count(b => b.Status == "Approved")</span>
        <span class="badge bg-info p-2">Paid: @Model.Bookings.Count(b => b.Status == "Paid")</span>
        <span class="badge bg-danger p-2">Cancelled: @Model.Bookings.Count(b => b.Status == "Cancelled")</span>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Guest</th>
                        <th>Check-in</th>
                        <th>Check-out</th>
                        <th>Guests</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Booked On</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model.Bookings)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@booking.GuestName</div>
                                <small class="text-muted">@booking.GuestEmail</small>
                            </td>
                            <td>@booking.CheckIn.ToString("MMM dd, yyyy")</td>
                            <td>@booking.CheckOut.ToString("MMM dd, yyyy")</td>
                            <td><i class="bi bi-person text-muted"></i> @booking.GuestsCount</td>
                            <td class="text-primary fw-bold">@booking.TotalPrice.ToString("C")</td>
                            <td>
                                @if (booking.Status == "Pending")
                                {
                                    <span class="badge bg-secondary">Pending</span>
                                }
                                else if (booking.Status == "Approved")
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else if (booking.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger">Cancelled</span>
                                }
                                else
                                {
                                    <span class="badge bg-info">@booking.Status</span>
                                }
                            </td>
                            <td class="text-muted">@booking.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="text-center">
                                @if (booking.Status == "Pending")
                                {
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="ConfirmBookingView"
                                               asp-route-bookingId="@booking.BookingId"
                                               asp-route-propertyId="@Model.PropertyId"
                                               class="btn btn-sm btn-success px-3">
                                            Approve
                                        </a>
                                        <a asp-action="CancelBookingView"
                                               asp-route-bookingId="@booking.BookingId"
                                               asp-route-propertyId="@Model.PropertyId"
                                               class="btn btn-sm btn-outline-danger px-3">
                                            Reject
                                        </a>
                                    </div>
                                }
                                else if (booking.Status == "Approved")
                                {
                                    <a asp-action="CancelBookingView"
                                           asp-route-bookingId="@booking.BookingId"
                                           asp-route-propertyId="@Model.PropertyId"
                                           class="btn btn-sm btn-outline-danger px-3">
                                        Cancel Booking
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">No actions</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>