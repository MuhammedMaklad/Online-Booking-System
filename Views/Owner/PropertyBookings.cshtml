@model Online_Booking_System.ViewModels.PropertyBookingsViewModel

@{
    ViewData["Title"] = $"Bookings – {Model.PropertyTitle}";
}

<div class="container py-5">

    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-action="MyProperties" class="btn btn-outline-secondary rounded-circle p-2 lh-1">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h2 class="fw-bold mb-0">
                <i class="bi bi-calendar-week text-primary me-2"></i>Bookings
            </h2>
            <p class="text-muted mb-0">@Model.PropertyTitle</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Bookings.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-calendar-x text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 fw-bold">No bookings yet</h4>
            <p class="text-muted">This property hasn't received any bookings.</p>
        </div>
    }
    else
    {
        <!-- Summary Badges -->
        <div class="d-flex gap-3 flex-wrap mb-4">
            <span class="badge bg-secondary rounded-pill px-3 py-2 fs-6">
                Total: @Model.Bookings.Count
            </span>
            <span class="badge bg-warning text-dark rounded-pill px-3 py-2 fs-6">
                Pending: @Model.Bookings.Count(b => b.Status == "Pending")
            </span>
            <span class="badge bg-success rounded-pill px-3 py-2 fs-6">
                Confirmed: @Model.Bookings.Count(b => b.Status == "Confirmed")
            </span>
            <span class="badge bg-danger rounded-pill px-3 py-2 fs-6">
                Cancelled: @Model.Bookings.Count(b => b.Status == "Cancelled")
            </span>
        </div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Guest</th>
                            <th>Check-in</th>
                            <th>Check-out</th>
                            <th>Guests</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Booked On</th>
                            <th class="pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.Bookings)
                        {
                            string badgeClass = b.Status switch
                            {
                                "Pending" => "bg-warning text-dark",
                                "Confirmed" => "bg-success",
                                "Cancelled" => "bg-danger",
                                _ => "bg-secondary"
                            };

                            <tr>
                                <td class="ps-4">
                                    <div class="fw-semibold">@b.GuestName</div>
                                    <small class="text-muted">@b.GuestEmail</small>
                                </td>
                                <td>@b.CheckIn.ToString("MMM dd, yyyy")</td>
                                <td>@b.CheckOut.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <i class="bi bi-person-fill me-1 text-muted"></i>@b.GuestsCount
                                </td>
                                <td class="fw-bold text-primary">$@b.TotalPrice</td>
                                <td>
                                    <span class="badge @badgeClass rounded-pill px-3">@b.Status</span>
                                </td>
                                <td class="text-muted small">@b.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td class="pe-4">
                                    <div class="d-flex gap-2">
                                        @if (b.Status == "Pending")
                                        {
                                            <form asp-action="ConfirmBooking" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="bookingId" value="@b.BookingId" />
                                                <input type="hidden" name="propertyId" value="@Model.PropertyId" />
                                                <button type="submit"
                                                        class="btn btn-success btn-sm rounded-pill px-3"
                                                        onclick="return confirm('Confirm this booking?')">
                                                    <i class="bi bi-check-lg me-1"></i>Confirm
                                                </button>
                                            </form>
                                        }
                                        @if (b.Status != "Cancelled")
                                        {
                                            <form asp-action="CancelBooking" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="bookingId" value="@b.BookingId" />
                                                <input type="hidden" name="propertyId" value="@Model.PropertyId" />
                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                                        onclick="return confirm('Cancel this booking?')">
                                                    <i class="bi bi-x-lg me-1"></i>Cancel
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>
