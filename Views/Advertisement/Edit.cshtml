@model Online_Booking_System.ViewModels.CreateAdvertisementViewModel

@{
    ViewData["Title"] = "Edit Advertisement";
    int adId = ViewBag.AdId;
    string currentStatus = ViewBag.CurrentStatus ?? "Pending";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="d-flex align-items-center gap-3 mb-4">
                <a asp-action="MyAdvertisements"
                       class="btn btn-outline-secondary rounded-circle p-2 lh-1">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <div>
                    <h2 class="fw-bold mb-0">Edit Advertisement</h2>
                    <p class="text-muted mb-0">Update your advertisement details</p>
                </div>
            </div>

            @if (currentStatus == "Approved")
            {
                <div class="alert alert-warning d-flex gap-2 align-items-start mb-4">
                    <i class="bi bi-exclamation-triangle-fill mt-1 flex-shrink-0"></i>
                    <div class="small">
                        This advertisement is currently <strong>Approved and live</strong>.
                        Editing it will set it back to <strong>Pending</strong> and
                        require admin re-approval before it goes live again.
                    </div>
                </div>
            }

            @if (currentStatus == "Rejected")
            {
                <div class="alert alert-info d-flex gap-2 align-items-start mb-4">
                    <i class="bi bi-info-circle-fill mt-1 flex-shrink-0"></i>
                    <div class="small">
                        This advertisement was <strong>Rejected</strong>.
                        Update your content and resubmit for admin review.
                    </div>
                </div>
            }

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-lg-5">

                    <form asp-action="Edit" asp-route-id="@adId" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold"></label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ImageUrl" class="form-label fw-semibold">
                                Image URL
                                <small class="text-muted fw-normal">(optional)</small>
                            </label>
                            <input asp-for="ImageUrl" class="form-control" />
                            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                        </div>

                        <div class="alert alert-info d-flex gap-2 align-items-start">
                            <i class="bi bi-info-circle-fill mt-1 flex-shrink-0"></i>
                            <div class="small">
                                Saving changes will reset the status to
                                <strong>Pending</strong> and the admin will
                                review your updated advertisement.
                            </div>
                        </div>

                        <div class="d-flex gap-3 pt-2">
                            <button type="submit" class="btn btn-primary px-5 rounded-pill">
                                <i class="bi bi-check-lg me-1"></i> Save &amp; Resubmit
                            </button>
                            <a asp-action="MyAdvertisements"
                                   class="btn btn-outline-secondary rounded-pill px-4">
                                Cancel
                            </a>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}