@{
    ViewData["Title"] = "Delete Advertisement";
    int adId = ViewBag.AdId;
}

@model Online_Booking_System.ViewModels.CreateAdvertisementViewModel

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-lg-5 text-center">

                    <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex p-4 mb-4">
                        <i class="bi bi-megaphone-fill text-danger" style="font-size:2.5rem;"></i>
                    </div>

                    <h3 class="fw-bold mb-2">Delete Advertisement</h3>
                    <p class="text-muted mb-4">
                        Are you sure you want to delete
                        <strong>@Model.Title</strong>?
                        This action cannot be undone.
                    </p>

                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="card border rounded-3 mb-4 text-start overflow-hidden">
                            <img src="@Model.ImageUrl" style="height:160px; object-fit:cover;"
                                 class="w-100" alt="@Model.Title" />
                            <div class="p-3">
                                <div class="fw-bold">@Model.Title</div>
                                <div class="text-muted small">
                                    @(Model.Description.Length > 80
                                        ? Model.Description[..80] + "..."
                                        : Model.Description)
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="card border rounded-3 mb-4 text-start p-3">
                            <div class="fw-bold">@Model.Title</div>
                            <div class="text-muted small">
                                @(Model.Description.Length > 80
                                    ? Model.Description[..80] + "..."
                                    : Model.Description)
                            </div>
                        </div>
                    }

                    <div class="d-flex gap-3 justify-content-center">
                        <form asp-action="Delete" asp-route-id="@adId" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger px-5 rounded-pill">
                                <i class="bi bi-trash me-1"></i> Yes, Delete
                            </button>
                        </form>
                        <a asp-action="MyAdvertisements"
                               class="btn btn-outline-secondary rounded-pill px-4">
                            Cancel
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>